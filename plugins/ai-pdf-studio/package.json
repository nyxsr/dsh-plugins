{
  "name": "@local/ai-pdf-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI PDF Studio Ultimate: adaptive PDF production, visual review, and repair.",
  "exports": {
    ".": "./index.js",
    "./cli": "./src/cli.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "ai-pdf-studio": "./src/cli.js"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "src/**/*.py",
    "templates/**/*",
    "assets/**/*",
    "examples/**/*",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "config/*.yaml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check:style": "node scripts/check_style.js"
  }
}
